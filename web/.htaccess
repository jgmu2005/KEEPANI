# Evita que el navegador cachee el HTML: siempre revalida contra el servidor,
# así al actualizar el sitio se ve la última versión sin recarga forzada.
# (Los .php ya no se cachean; imágenes/CSS/JS embebido van dentro del HTML.)
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# URL propia y compartible para el comparador de celulares.
# Rewrite INTERNO a index.html (mismo directorio ⇒ las rutas relativas del SPA
# —./api, producto.php— siguen resolviendo igual). El SPA detecta la ruta y abre
# la vista de celulares. Se usa sin barra final (así lo genera history.pushState).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── DOMINIO CANÓNICO: 301 a https://ojoalprecio.online (sin www) ──
    # Sin esto, Google indexa 4 variantes (http/https × www/no-www) como duplicados.
    # 1) www → sin www (siempre a https).
    RewriteCond %{HTTP_HOST} ^www\.ojoalprecio\.online$ [NC]
    RewriteRule ^ https://ojoalprecio.online%{REQUEST_URI} [L,R=301]
    # 2) http → https (con guarda X-Forwarded-Proto para no hacer loop si el SSL
    #    lo termina un proxy y Apache ve la request como http).
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://ojoalprecio.online%{REQUEST_URI} [L,R=301]

    RewriteRule ^compara-telefonos$ index.html [L]

    # URL amigable y con keywords por producto: /precio/{id}/{slug-opcional}
    # → precio.php?id={id} (server-rendered; los links internos usan URL absoluta).
    RewriteRule ^precio/([0-9]+)(/[^/]*)?$ precio.php?id=$1 [L,QSA]

    # Cazaofertas Walmart (feed de liquidaciones) con URL propia.
    RewriteRule ^liquidaciones$ liquidaciones.php [L,QSA]

    # Índice de sitemaps con nombre canónico.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Marketplace de tiendas locales (Treinta), aislado del tracker.
    RewriteRule ^marketplace$ marketplace.php [L,QSA]

    # Ofertas del día (motor de contenido para el canal de WhatsApp).
    RewriteRule ^hoy$ hoy.php [L,QSA]
</IfModule>
