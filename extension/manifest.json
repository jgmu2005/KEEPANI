{
  "manifest_version": 3,
  "name": "Ojo al Precio",
  "version": "0.4.0",
  "description": "Historial de precios, comparación entre tiendas y alertas de baja, en la página del producto de tiendas de Nicaragua.",
  "content_scripts": [
    {
      "matches": [
        "https://sinsa.com.ni/*",
        "https://*.sinsa.com.ni/*",
        "https://ni.siman.com/*",
        "https://siman.com/*",
        "https://copasa.com.ni/*",
        "https://*.copasa.com.ni/*",
        "https://walmart.com.ni/*",
        "https://*.walmart.com.ni/*",
        "https://elgallomasgallo.com.ni/*",
        "https://*.elgallomasgallo.com.ni/*",
        "https://lacuracaonline.com/*",
        "https://*.lacuracaonline.com/*",
        "https://radioshackla.com/*",
        "https://*.radioshackla.com/*",
        "https://almacenestropigas.com/*",
        "https://*.almacenestropigas.com/*",
        "https://pricesmart.com/*",
        "https://*.pricesmart.com/*",
        "https://gcm.com.ni/*",
        "https://*.gcm.com.ni/*",
        "https://casadelaslamparas.com.ni/*",
        "https://*.casadelaslamparas.com.ni/*",
        "https://fogel.com.ni/*",
        "https://*.fogel.com.ni/*",
        "https://telcmax.com/*",
        "https://*.telcmax.com/*",
        "https://fetesa.com.ni/*",
        "https://*.fetesa.com.ni/*",
        "https://fitshop.com.ni/*",
        "https://*.fitshop.com.ni/*",
        "https://etech.com.ni/*",
        "https://*.etech.com.ni/*",
        "https://pcsystemni.com/*",
        "https://*.pcsystemni.com/*",
        "https://cubitt.com.ni/*",
        "https://*.cubitt.com.ni/*",
        "https://simpletechnic.com/*",
        "https://*.simpletechnic.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ojoalprecio.online/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ojo al Precio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-16.png"],
      "matches": ["https://ojoalprecio.online/*"]
    }
  ]
}
