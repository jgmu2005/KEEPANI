{
  "manifest_version": 3,
  "name": "Ojo al Precio",
  "version": "0.1.1",
  "description": "Muestra el historial de precios (Sinsa, Siman, Copasa) directo en la página del producto.",
  "content_scripts": [
    {
      "matches": [
        "https://sinsa.com.ni/*",
        "https://*.sinsa.com.ni/*",
        "https://ni.siman.com/*",
        "https://siman.com/*",
        "https://copasa.com.ni/*",
        "https://*.copasa.com.ni/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ojoalprecio.online/*",
    "https://agrotecnicaragua.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ojo al Precio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
